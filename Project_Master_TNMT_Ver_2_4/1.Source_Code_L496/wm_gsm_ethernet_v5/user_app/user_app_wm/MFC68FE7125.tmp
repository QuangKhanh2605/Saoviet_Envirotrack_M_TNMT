/*===================== Handle Callback Reg Modbus RTU ===================*/
uint8_t NONE_Register_Read(sData *sDes, uint8_t Length)
{
    sDes->Data_a8[sDes->Length_u16++] = 0x00;
    sDes->Data_a8[sDes->Length_u16++] = 0x00;
    return 1;
}

uint8_t NONE_Register_Write(sData *sDes, sData *str, uint16_t Pos)
{
    return 0;
}

/*----------- _E_REGISTER_ID -----------*/
uint8_t _Cb_R_ModbusRTU_REG_ID(sData *sDes, uint8_t Length)
{
    if(Length == 0)
        return 0;
    sDes->Data_a8[sDes->Length_u16++] = 0;
    sDes->Data_a8[sDes->Length_u16++] = sSlave_ModbusRTU.ID;
    return 1;
}

uint8_t _Cb_W_ModbusRTU_REG_ID(sData *sDes, sData *str, uint16_t Pos)
{
    uint16_t ConvertData = 0;
    uint8_t pos = 0;
    pos = Pos;
    ConvertData = str->Data_a8[pos] << 8 | str->Data_a8[pos+1]; 
    if(ConvertData < 256 && ConvertData > 0)
    {
        sDes->Data_a8[sDes->Length_u16++] = str->Data_a8[pos];
        sDes->Data_a8[sDes->Length_u16++] = str->Data_a8[pos+1];
        
//        Save_InforSlaveModbusRTU(sSlave_ModbusRTU.Mode_u8,(uint8_t)ConvertData,sSlave_ModbusRTU.Baudrate);
        return 1;
    }
    return 0;
}

/*----------- _E_REGISTER_BAUDRATE -----------*/
uint8_t _Cb_R_ModbusRTU_REG_Baudrate(sData *sDes, uint8_t Length)
{
    if(Length == 0)
        return 0;
    sDes->Data_a8[sDes->Length_u16++] = 0;
    sDes->Data_a8[sDes->Length_u16++] = sSlave_ModbusRTU.Baudrate;
    return 1;
}

uint8_t _Cb_W_ModbusRTU_REG_Baudrate(sData *sDes, sData *str, uint16_t Pos)
{
    uint16_t ConvertData = 0;
    uint8_t pos = 0;
    pos = Pos;
    ConvertData = str->Data_a8[pos] << 8 | str->Data_a8[pos+1]; 
    if(ConvertData < 11)
    {
        sDes->Data_a8[sDes->Length_u16++] = str->Data_a8[pos];
        sDes->Data_a8[sDes->Length_u16++] = str->Data_a8[pos+1];
//        Save_InforSlaveModbusRTU(sSlave_ModbusRTU.Mode_u8, sSlave_ModbusRTU.ID, (uint8_t)ConvertData);
        return 1;
    }
    return 0;
}

/*----------- _E_REGISTER_UNIT -----------*/
uint8_t _Cb_R_ModbusRTU_REG_Unit(sData *sDes, uint8_t Length)
{
    if(Length == 0)
        return 0;
    sDes->Data_a8[sDes->Length_u16++] = 0x00;
    sDes->Data_a8[sDes->Length_u16++] = 0x01;
    return 1;
}

/*----------- _E_REGISTER_DECIMAL_POINT -----------*/
uint8_t _Cb_R_ModbusRTU_REG_Decimal_Point(sData *sDes, uint8_t Length)
{
    if(Length == 0)
        return 0;
    sDes->Data_a8[sDes->Length_u16++] = 0x00;
    sDes->Data_a8[sDes->Length_u16++] = 0x00;
    return 1;
}

/*----------- _E_REGISTER_RESTORE_VALUE -----------*/
uint8_t _Cb_R_ModbusRTU_REG_Value(sData *sDes, uint8_t Length)
{
    if(Length == 0)
        return 0;
    int16_t Value = 0;
//    Value = (int16_t)(sSensorLevel.LevelValueFilter_f);
    sDes->Data_a8[sDes->Length_u16++] = Value >> 8;
    sDes->Data_a8[sDes->Length_u16++] = Value;
    return 1;
}

/*----------- _E_REGISTER_ZERO_POINT -----------*/
uint8_t _Cb_R_ModbusRTU_REG_Zero_Point(sData *sDes, uint8_t Length)
{
    if(Length == 0)
        return 0;
    sDes->Data_a8[sDes->Length_u16++] = 0x00;
    sDes->Data_a8[sDes->Length_u16++] = 0x32;
    return 1;
}

/*----------- _E_REGISTER_RESTORE -----------*/
uint8_t _Cb_W_ModbusRTU_REG_ID_Restore(sData *sDes, sData *str, uint16_t Pos)
{
    uint16_t ConvertData = 0;
    uint8_t pos = 0;
    pos = Pos;
    ConvertData = str->Data_a8[pos] << 8 | str->Data_a8[pos+1]; 
    if(ConvertData == 0x0001)
    {
        sDes->Data_a8[sDes->Length_u16++] = str->Data_a8[pos];
        sDes->Data_a8[sDes->Length_u16++] = str->Data_a8[pos+1];
//        OnchipFlashPageErase(ADDR_CALIB_TEMPERATURE);
//        sSensorLevel.Calib_Offset = 0;
//        sSensorLevel.CalibPoint1_x_f = LEVEL_MIN;
//        sSensorLevel.CalibPoint1_y_f = LEVEL_MIN;
//        sSensorLevel.CalibPoint2_x_f = LEVEL_MAX;
//        sSensorLevel.CalibPoint2_y_f = LEVEL_MAX;
//        
//        OnchipFlashPageErase(ADDR_TEMPERATURE_ALARM);
//        OnchipFlashPageErase(ADDR_CALIB_TEMPERATURE);
//        sTempAlarm.State = 0;
//        sTempAlarm.Alarm_Upper = LEVEL_MAX;
//        sTempAlarm.Alarm_Lower = LEVEL_MIN;
        return 1;
    }
    return 0;
}

/*----------- _E_REGISTER_TEMP_COMPENSATION -----------*/
uint8_t _Cb_R_ModbusRTU_REG_Compensation(sData *sDes, uint8_t Length)
{
    if(Length == 0)
        return 0;
    uint32_t hexValue = 0;
    hexValue = Handle_Float_To_hexUint32(sMeasureMain[0][_SS_PH].Value_f);
    sDes->Data_a8[sDes->Length_u16++] = hexValue >> 8;
    sDes->Data_a8[sDes->Length_u16++] = hexValue;
    if(Length >= 2)
    {
        sDes->Data_a8[sDes->Length_u16++] = hexValue >> 24;
        sDes->Data_a8[sDes->Length_u16++] = hexValue >> 16;
        return 2;
    }
    return 1;
}

uint8_t _Cb_W_ModbusRTU_REG_Compensation(sData *sDes, sData *str, uint16_t Pos)
{
    uint32_t ConvertData = 0;
    float Convert_F = 0;
    uint8_t pos = 0;
    pos = Pos;
    ConvertData = str->Data_a8[pos+2]<<8 | str->Data_a8[pos+3];
    ConvertData = (ConvertData << 16) | (str->Data_a8[pos]<<8 | str->Data_a8[pos+1]);
    sDes->Data_a8[sDes->Length_u16++] = str->Data_a8[pos];
    sDes->Data_a8[sDes->Length_u16++] = str->Data_a8[pos+1];
    sDes->Data_a8[sDes->Length_u16++] = str->Data_a8[pos+2];
    sDes->Data_a8[sDes->Length_u16++] = str->Data_a8[pos+3];
    
    Convert_uint32Hex_To_Float(ConvertData, &Convert_F);
//    Save_CalibTemperature(_KIND_CALIB_OFFSET, Convert_F);
    return 1;
}

