uint8_t aframe[128] = {0};
/*====================== Handle Receive Modbus RTU =======================*/
uint8_t Modem_Check_RTU(uint8_t Kind, sData *StrUartRecei, sData *Destination)
{
#ifdef USING_CHECK_MODBUS_RTU
    uint16_t Crc_Check = 0;
    uint16_t Crc_Recv = 0;
    uint16_t Register = 0;
    uint16_t Length = 0;
    
	sData sDataConfig = {aDATA_CONFIG, 0};
    sData sDataPDU;
    uint16_t var = 0;

    sData sFrame={aframe,0};
    
    Reset_Buff(&sLogData_ModbusRTU);
    
    uint16_t Transaction = 0;
    uint16_t ProtocolID = 0xFFFF;
    uint16_t Length_TCP = 0;
    
    uint8_t Result = 0;
    
    if(StrUartRecei->Length_u16 >= 8)
    {
        if(Kind == _E_MODB_RTU)
        {
            Crc_Recv = (StrUartRecei->Data_a8[StrUartRecei->Length_u16 - 1] << 8) |
                       (StrUartRecei->Data_a8[StrUartRecei->Length_u16 - 2]);
            Crc_Check = ModRTU_CRC(StrUartRecei->Data_a8, StrUartRecei->Length_u16 - 2);
            
            if(Crc_Check == Crc_Recv && StrUartRecei->Data_a8[0] == sSlave_ModbusRTU.ID)
            {
                sDataPDU.Data_a8 = &StrUartRecei->Data_a8[0];
                sDataPDU.Length_u16 = StrUartRecei->Length_u16 - 2;
                Register = (sDataPDU.Data_a8[2] << 8) | sDataPDU.Data_a8[3];
            }
            else
                return 0;
        }
        else
        {
            Transaction = StrUartRecei->Data_a8[0] << 8 | StrUartRecei->Data_a8[1];
            ProtocolID = StrUartRecei->Data_a8[2] << 8 | StrUartRecei->Data_a8[3];
            Length_TCP = StrUartRecei->Data_a8[4] << 8 | StrUartRecei->Data_a8[5];
            if(ProtocolID == 0 && Length_TCP == (StrUartRecei->Length_u16 - 6))
            {
                sDataPDU.Data_a8 = &StrUartRecei->Data_a8[6];
                sDataPDU.Length_u16 = StrUartRecei->Length_u16 - 6;
                Register = (sDataPDU.Data_a8[2] << 8) | sDataPDU.Data_a8[3];
            }
            else
                return 0;
        }
            
        switch(sDataPDU.Data_a8[1])
        {
            case 0x03:
            case 0x04:
              Length = (sDataPDU.Data_a8[4] << 8) | sDataPDU.Data_a8[5];
              while(Length > 0)
              {
                  uint8_t uReg = 0;
                  for(uint8_t i = _E_REGISTER_BEGIN+1; i < _E_REGISTER_END; i++)
                  {
                    if(sCheckList_Reg_Modbus_RTU[i].idRegister == Register)
                    {
                        Length = Length - sCheckList_Reg_Modbus_RTU[i].CallBack_Read(&sLogData_ModbusRTU, Length);
                        Register += sCheckList_Reg_Modbus_RTU[i].Length;
                        uReg = 1;
                    }
                  }
                  if(uReg == 0)
                  {
                    sLogData_ModbusRTU.Data_a8[sLogData_ModbusRTU.Length_u16++] = 0x00;
                    sLogData_ModbusRTU.Data_a8[sLogData_ModbusRTU.Length_u16++] = 0x00;
                    Register++;
                    Length--;
                  }
              }

              if(sLogData_ModbusRTU.Length_u16 > 0 && sLogData_ModbusRTU.Length_u16%2 == 0)
              {
                ModRTU_Slave_ACK_Read_Frame(&sFrame, sDataPDU.Data_a8[0], sDataPDU.Data_a8[1], Register, sLogData_ModbusRTU.Length_u16/2, sLogData_ModbusRTU.Data_a8);
                Result = 1;
              }
              break;
              
            case 0x06:
              for(uint8_t i = 4; i < sDataPDU.Length_u16; i++)
              {
                sDataConfig.Data_a8[sDataConfig.Length_u16++] = sDataPDU.Data_a8[i];
              }
              for(uint8_t i = _E_REGISTER_BEGIN+1; i < _E_REGISTER_END; i++)
              {
                if(sCheckList_Reg_Modbus_RTU[i].idRegister == Register)
                {
                  sCheckList_Reg_Modbus_RTU[i].CallBack_Write(&sLogData_ModbusRTU, &sDataConfig, 0);
                }
              }         
              if(sLogData_ModbusRTU.Length_u16 > 0 && sLogData_ModbusRTU.Length_u16%2 == 0)
              {
                ModRTU_Slave_ACK_Write_Frame(&sFrame, sDataPDU.Data_a8[0], 0x06, Register, sLogData_ModbusRTU.Length_u16/2, sLogData_ModbusRTU.Data_a8);
                Result = 1;
              }
              break;
              
            case 0x10:
              var = 0;
              Length = (sDataPDU.Data_a8[4] << 8) | sDataPDU.Data_a8[5];
              for(uint8_t i = 7; i < sDataPDU.Length_u16; i++)
              {
                sDataConfig.Data_a8[sDataConfig.Length_u16++] = sDataPDU.Data_a8[i];
              }
              if((Length*2 == sDataPDU.Data_a8[6]) && (sDataConfig.Length_u16 == sDataPDU.Data_a8[6]))
              {
                  for(uint8_t i = _E_REGISTER_BEGIN+1; i < _E_REGISTER_END; i++)
                  {
                    if(sCheckList_Reg_Modbus_RTU[i].idRegister == Register)
                    {
                       if(sCheckList_Reg_Modbus_RTU[i].Length <= Length)
                       {
                           if(sCheckList_Reg_Modbus_RTU[i].CallBack_Write(&sLogData_ModbusRTU, &sDataConfig, var) == 1)
                           {
                               var += (sCheckList_Reg_Modbus_RTU[i].Length)*2;
                               Length -= sCheckList_Reg_Modbus_RTU[i].Length;
                               Register += sCheckList_Reg_Modbus_RTU[i].Length;
                           }
                           else 
                             break;
                       }
                    }
                  }   
              }
              if(sLogData_ModbusRTU.Length_u16 > 0 && sLogData_ModbusRTU.Length_u16%2 == 0)
              {
                Register = (sDataPDU.Data_a8[2] << 8) | sDataPDU.Data_a8[3];
                ModRTU_Slave_ACK_Write_Frame(&sFrame, sDataPDU.Data_a8[0], 0x10, Register, sLogData_ModbusRTU.Length_u16/2, sLogData_ModbusRTU.Data_a8);
                Result = 1;
              }
              break;
          
            default:
              return 0;
              break;
        }
        
        if(Result == 1)
        {
            if(Kind == _E_MODB_TCP)
            {
                Destination->Data_a8[Destination->Length_u16++] = Transaction >> 8;
                Destination->Data_a8[Destination->Length_u16++] = Transaction;
                Destination->Data_a8[Destination->Length_u16++] = ProtocolID >> 8;
                Destination->Data_a8[Destination->Length_u16++] = ProtocolID;
                Destination->Data_a8[Destination->Length_u16++] = (sFrame.Length_u16 - 2) >> 8;
                Destination->Data_a8[Destination->Length_u16++] = (sFrame.Length_u16 - 2);
            }
            
            for(uint8_t i = 0; i < sFrame.Length_u16 - 2; i++)
                Destination->Data_a8[Destination->Length_u16++] = sFrame.Data_a8[i];
            
            if(Kind == _E_MODB_RTU)
            {
                Destination->Data_a8[Destination->Length_u16++] = sFrame.Data_a8[sFrame.Length_u16-2];  //CRC
                Destination->Data_a8[Destination->Length_u16++] = sFrame.Data_a8[sFrame.Length_u16-1];  //CRC
            }
        }
        
    }
    else
        return 0;
  
    return 1;
#else
    return 0;
#endif
}


